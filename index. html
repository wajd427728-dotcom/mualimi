<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>بوابة ولي الأمر - مدرسة الذاريات الابتدائية</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&display=swap" rel="stylesheet">
    <style>body { font-family: 'Cairo', sans-serif; background-color: #0f172a; color: #f8fafc; }</style>
</head>
<body class="min-h-screen flex flex-col items-center justify-start p-3 sm:p-4">

    <header class="w-full max-w-md bg-slate-800/90 backdrop-blur border border-slate-700 rounded-2xl p-4 mb-4 shadow-xl text-center">
        <div class="flex items-center justify-between mb-2">
            <span class="text-xs bg-amber-500/20 text-amber-400 px-2.5 py-1 rounded-full font-bold">العام الدراسي 2025-2026</span>
            <span class="text-xs bg-blue-500/20 text-blue-400 px-2.5 py-1 rounded-full font-bold">الرصافة الثانية</span>
        </div>
        <h1 class="text-xl font-black text-amber-400">مدرسة الذاريات الابتدائية</h1>
        <p class="text-xs text-slate-300 mt-1">بوابة متابعة التلاميذ والمرشد التربوي</p>
    </header>

    <main class="w-full max-w-md space-y-4">
        <div class="bg-slate-800 border border-slate-700 rounded-2xl p-4 shadow-lg space-y-3 text-center">
            <h2 class="text-base font-bold text-amber-400">استعلام عن نتائج التلميذ</h2>
            <p class="text-xs text-slate-300">أدخل الكود المخصص لتلميذك (مثلاً: STU-601) للاطلاع على السجل والدرجات:</p>
            <div class="flex gap-2">
                <input type="text" id="parent-code-input" placeholder="أدخل الكود هنا..." class="flex-1 bg-slate-900 border border-slate-700 rounded-xl p-2.5 text-xs text-center uppercase tracking-widest text-white">
                <button onclick="searchStudentByCode()" class="bg-amber-500 text-slate-950 font-bold px-4 py-2 rounded-xl text-xs">استعلام 🔍</button>
            </div>
        </div>

        <div id="parent-result-view" class="space-y-4 hidden">
            <div class="bg-slate-800 border border-slate-700 rounded-2xl p-4 shadow-lg space-y-3">
                <div class="flex justify-between items-center border-b border-slate-700 pb-2">
                    <div>
                        <h3 id="res-name" class="font-bold text-sm text-amber-400"></h3>
                        <p id="res-class" class="text-xs text-slate-400"></p>
                    </div>
                    <span id="res-code" class="text-xs bg-slate-700 px-2 py-1 rounded font-mono text-amber-300"></span>
                </div>

                <div class="grid grid-cols-4 gap-2 text-center text-xs">
                    <div class="bg-slate-900 p-2 rounded-xl border border-slate-700"><span class="text-slate-400 block text-[10px]">تشرين</span><span id="res-oct" class="font-bold text-white">-</span></div>
                    <div class="bg-slate-900 p-2 rounded-xl border border-slate-700"><span class="text-slate-400 block text-[10px]">كانون</span><span id="res-dec" class="font-bold text-white">-</span></div>
                    <div class="bg-slate-900 p-2 rounded-xl border border-slate-700"><span class="text-slate-400 block text-[10px]">نصف السنة</span><span id="res-mid" class="font-bold text-white">-</span></div>
                    <div class="bg-slate-900 p-2 rounded-xl border border-slate-700"><span class="text-slate-400 block text-[10px]">المعدل</span><span id="res-avg" class="font-bold text-amber-400">-</span></div>
                </div>

                <div class="bg-slate-900 p-3 rounded-xl border border-slate-700 space-y-1">
                    <span class="text-xs text-amber-400 font-bold block"><i class="fa-solid fa-heart-pulse"></i> ملاحظات وتوجيهات المرشد التربوي:</span>
                    <p id="res-notes" class="text-xs text-slate-300">لا توجد ملاحظات مسجلة حالياً.</p>
                </div>

                <div id="res-certificate-box" class="hidden">
                    <div class="bg-gradient-to-r from-amber-500/20 to-yellow-500/20 border border-amber-500/50 p-3 rounded-xl text-center space-y-1">
                        <i class="fa-solid fa-award text-amber-400 text-xl"></i>
                        <h4 class="font-bold text-xs text-amber-300">شهادة تقديرية وتكريم تفوق 🏆</h4>
                    </div>
                </div>

                <div id="res-ministerial-box" class="hidden pt-2">
                    <button onclick="openMinisterialModal()" class="w-full bg-blue-600 hover:bg-blue-500 text-white font-bold p-2.5 rounded-xl text-xs flex items-center justify-center gap-2">
                        <i class="fa-solid fa-book-open"></i> فتح أرشيف الأسئلة الوزارية (للصف السادس) 📚
                    </button>
                </div>
            </div>
        </div>
    </main>

    <!-- نافذة الأسئلة الوزارية -->
    <div id="ministerial-modal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-slate-800 border border-slate-700 w-full max-w-md rounded-2xl p-4 space-y-4 max-h-[80vh] overflow-y-auto">
            <div class="flex justify-between items-center border-b border-slate-700 pb-2">
                <h3 class="font-bold text-sm text-amber-400">أرشيف الأسئلة الوزارية (السادس الابتدائي)</h3>
                <button onclick="closeMinisterialModal()" class="text-slate-400 hover:text-white"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div class="space-y-2 text-xs">
                <div class="bg-slate-900 p-3 rounded-xl border border-slate-700 flex justify-between items-center">
                    <span>أسئلة اللغة العربية - الدور الأول 2024</span>
                    <a href="https://moedu.gov.iq" target="_blank" class="bg-blue-600 px-3 py-1.5 rounded-lg text-white font-bold">معاينة</a>
                </div>
            </div>
        </div>
    </div>

    <script>
        let studentsData = JSON.parse(localStorage.getItem('dhariyat_students')) || [
            { id: 'STU-601', name: 'سجاد حيدر محمد', class: 'السادس الابتدائي', section: 'أ', oct: 95, dec: 90, mid: 92, final: '', notes: 'تلميذ متفوق جداً وذو سلوك ممتاز.', isTop: true }
        ];

        function searchStudentByCode() {
            const code = document.getElementById('parent-code-input').value.trim().toUpperCase();
            const s = studentsData.find(x => x.id === code);
            const resView = document.getElementById('parent-result-view');
            if(!s) { alert('عذراً، الكود المدخل غير صحيح.'); resView.classList.add('hidden'); return; }
            resView.classList.remove('hidden');
            document.getElementById('res-name').innerText = s.name;
            document.getElementById('res-class').innerText = `${s.class} - شعبة ${s.section}`;
            document.getElementById('res-code').innerText = s.id;
            document.getElementById('res-oct').innerText = s.oct || '-';
            document.getElementById('res-dec').innerText = s.dec || '-';
            document.getElementById('res-mid').innerText = s.mid || '-';
            const vals = [s.oct, s.dec, s.mid].filter(v => v !== '' && !isNaN(v)).map(Number);
            document.getElementById('res-avg').innerText = vals.length ? (vals.reduce((a,b)=>a+b)/vals.length).toFixed(1) : '-';
            document.getElementById('res-notes').innerText = s.notes || 'لا توجد ملاحظات مسجلة.';
            if(s.isTop) document.getElementById('res-certificate-box').classList.remove('hidden');
            else document.getElementById('res-certificate-box').classList.add('hidden');
            if(s.class.includes('السادس')) document.getElementById('res-ministerial-box').classList.remove('hidden');
            else document.getElementById('res-ministerial-box').classList.add('hidden');
        }

        function openMinisterialModal() { document.getElementById('ministerial-modal').classList.remove('hidden'); }
        function closeMinisterialModal() { document.getElementById('ministerial-modal').classList.add('hidden'); }
    </script>
</body>
</html>
